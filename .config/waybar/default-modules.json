{
    "hyprland/workspaces": {
        "on-click": "activate",
        "active-only": true,
        "all-outputs": true,
        "format": "{}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 6
        }
    },
    "hyprland/workspaces#icons": {
        "on-click": "activate",
        "active-only": true,
        "all-outputs": true,
        "format": "<sub> {icon}</sub>\n<small>{windows}</small>",
        "format-window-separator": " ",
        "window-rewrite-default": "",
        "max-icons": 1,
        "window-rewrite": {
            "title<.*youtube.*>": "",
            "class<firefox>": "",
            "class<firefox> title<.*github.*>": "",
            "kitty": "",
            "code": "󰨞",
            "brave": "󰒘",
        },
        "persistent-workspaces": {
            "*": 6
        }
    },
    "custom/icon": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "wofi"
    },
    "custom/exit": {
        "format": "",
        "tooltip-format": "Powermenu",
        "on-click": "wlogout",
        "tooltip": false
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰅸",
            "dnd-none": "󰂜"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/cava": {
        "format": "{}",
        "exec": "cava -p ~/.config/cava/config_waybar | sed -u 's/;//g; s/0/▁/g; s/1/▂/g; s/2/▃/g; s/3/▄/g; s/4/▅/g; s/5/▆/g; s/6/▇/g; s/7/█/g;'",
        "restart-interval": 0.006
    },
    "mpris": {
        "format": " {player_icon} {status_icon} {title} : {artist} : {position}/{length} ",
        "interval": 1,
        "status-icons": {
            "playing": "󰏤",
            "paused": ""
        },
        "player-icons": {
            "default": "󰎇",
            "brave": ""
        },
        "dynamic-separator": " : ",
        "title-len": 30
    },
    "clock": {
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "󰥔 {0:%H:%M}",
        "format": "󰥔 {0:%I:%M:%S %p}   {0:%a, %b %d}"
    },
    "network": {
        "format": "{ifname}",
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "",
        "format-disconnected": "󰲛",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": " {essid}",
        "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "interval": 1,
        "on-click": "kitty nmtui"
    },
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}{capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": "󱐥 {capacity}%",
        "format-alt": "{icon}{time}",
        "format-icons": [
            " ",
            " ",
            " ",
            " ",
            " "
        ]
    },
    "bluetooth": {
        "format-disabled": "",
        "format-off": "",
        "interval": 30,
        "on-click": "blueman-manager",
        "format-no-controller": ""
    },
    "user": {
        "format": "{user}",
        "icon": false
    },
    "cpu": {
    "format": " {usage}%",
    "on-click": "kitty -e btop"
    },
    "memory": {
        "format": " {}%",
        "on-click": "kitty -e btop"
    },
    "disk": {
        "interval": 30,
        "format": "D {percentage_used}% ",
        "path": "/",
        "on-click": "kitty -e btop"
    },
    "temperature": {
        "format": "{icon} {temperatureC}°C",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "interval": 2,
        "critical-threshold": 80,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input"
    },
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "disc",
            "temperature"
        ]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon} ",
        "format-bluetooth-muted": " {icon} ",
        "format-muted": " 0%",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "scroll-step": 5,
        "on-click-right": "pavucontrol",
        "on-click": "amixer set Master toggle"
    },
    "pulseaudio#mic": {
        "format": "{icon} {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "on-scroll-up": "amixer set Capture 5%+",
        "on-scroll-down": "amixer set Capture 5%-",
        "on-click-right": "pavucontrol",
        "on-click": "amixer set Capture toggle"
    },
    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio#mic"
        ]
    }
}